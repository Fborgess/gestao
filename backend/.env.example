# Render fornece a DATABASE_URL automaticamente no PostgreSQL
# Para desenvolvimento local, use SQLite:
DATABASE_URL=sqlite:///./gestao.db

# Gere uma chave secreta: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Credenciais do admin inicial (opcional -- se não definidas, gera senha aleatória no primeiro start)
# ADMIN_EMAIL=admin@exemplo.com
# ADMIN_PASSWORD=senha-segura

# CORS: origens separadas por vírgula (default: local dev + produção)
# CORS_ORIGINS=https://seu-dominio.com,http://localhost:5173

# Logs: INFO (padrão), DEBUG para desenvolvimento, WARNING para produção silenciosa
# LOG_LEVEL=INFO
# LOG_FORMAT=text  # ou "json" para logs estruturados
