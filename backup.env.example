# Copie para backup.env e preencha com a "External Database URL" do banco em producao:
# Render > Database > sua instancia > Info > External Database URL (comeca com postgres://)
#
# Exemplo:
# PROD_DATABASE_URL=postgres://usuario:senha@host-do-render.render.com:5432/nome_do_banco
#
# Deixe vazio para fazer apenas o backup local.
PROD_DATABASE_URL=
